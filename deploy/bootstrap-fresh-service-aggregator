#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Run as root" >&2
  exit 1
fi

deploy_public_key="${1:-}"
if [[ -z "$deploy_public_key" || "$deploy_public_key" != ssh-* ]]; then
  echo "Pass the GitHub deploy public key as the first argument" >&2
  exit 2
fi

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl nginx postgresql postgresql-client sudo openssl nodejs npm certbot python3-certbot-nginx

node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || echo 0)"
if (( node_major < 20 )); then
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  apt-get install -y nodejs
fi

id serviceagg >/dev/null 2>&1 || useradd --create-home --home-dir /home/serviceagg --shell /usr/sbin/nologin serviceagg
id serviceagg-deploy >/dev/null 2>&1 || useradd --create-home --home-dir /home/serviceagg-deploy --shell /bin/bash serviceagg-deploy

install -d -o serviceagg -g serviceagg -m 0750 /home/serviceagg/releases
install -d -o serviceagg-deploy -g serviceagg-deploy -m 0750 /home/serviceagg-deploy/incoming
install -d -o root -g root -m 0750 /etc/service-aggregator

install -d -o serviceagg-deploy -g serviceagg-deploy -m 0700 /home/serviceagg-deploy/.ssh
printf '%s\n' "$deploy_public_key" > /home/serviceagg-deploy/.ssh/authorized_keys
chown serviceagg-deploy:serviceagg-deploy /home/serviceagg-deploy/.ssh/authorized_keys
chmod 0600 /home/serviceagg-deploy/.ssh/authorized_keys

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
install -o root -g root -m 0755 "$script_dir/deploy-service-aggregator" /usr/local/sbin/deploy-service-aggregator
install -o root -g root -m 0644 "$script_dir/service-aggregator.service" /etc/systemd/system/service-aggregator.service

cat > /etc/sudoers.d/serviceagg-deploy <<'EOF'
serviceagg-deploy ALL=(root) NOPASSWD: /usr/local/sbin/deploy-service-aggregator
EOF
chmod 0440 /etc/sudoers.d/serviceagg-deploy
visudo -cf /etc/sudoers.d/serviceagg-deploy >/dev/null

db_password="$(openssl rand -hex 24)"
session_secret="$(openssl rand -hex 32)"

systemctl enable --now postgresql nginx >/dev/null

sudo -u postgres psql --set=ON_ERROR_STOP=1 --set=db_pass="$db_password" <<'SQL'
SELECT format('CREATE ROLE serviceagg LOGIN PASSWORD %L', :'db_pass')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'serviceagg') \gexec
SELECT format('ALTER ROLE serviceagg WITH LOGIN PASSWORD %L', :'db_pass') \gexec
SQL

sudo -u postgres psql --set=ON_ERROR_STOP=1 <<'SQL'
SELECT 'CREATE DATABASE serviceagg OWNER serviceagg'
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = 'serviceagg') \gexec
ALTER DATABASE serviceagg OWNER TO serviceagg;
SQL

cat > /etc/service-aggregator/app.env <<EOF
NODE_ENV=production
PORT=8081
DATABASE_URL=postgresql://serviceagg:${db_password}@127.0.0.1:5432/serviceagg
SESSION_SECRET=${session_secret}
PUBLIC_APP_URL=https://govza.pro
EOF
chmod 0600 /etc/service-aggregator/app.env

systemctl daemon-reload
systemctl enable service-aggregator.service >/dev/null

echo "Fresh Service Aggregator server bootstrap complete"
